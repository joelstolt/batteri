{
  "crons": [
    {
      "path": "/api/cron/veckorapport",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/kassa-paminnelse",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/omdome-paminnelse",
      "schedule": "0 8 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/order-integrity-20260904": false,
      "indexnow-state": false
    }
  },
  "rewrites": [
    {
      "source": "/marginaler",
      "destination": "https://batteriproffs-marginaler.joel-d77.workers.dev/"
    }
  ],
  "headers": [
    {
      "source": "/marginaler",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
